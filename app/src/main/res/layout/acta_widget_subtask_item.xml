<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/acta_widget_subtask_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/acta_widget_subtask_connector"
            android:layout_width="24dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/acta_widget_tree_middle" />

        <FrameLayout
            android:id="@+id/acta_widget_subtask_checkbox_target"
            android:layout_width="26dp"
            android:layout_height="32dp"
            android:layout_marginStart="-2dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Toggle subtask">

            <ImageView
                android:id="@+id/acta_widget_subtask_checkbox_box"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/acta_widget_subcheckbox_unchecked" />

            <ImageView
                android:id="@+id/acta_widget_subtask_checkbox_tick"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/acta_widget_checkmark"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left|center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/acta_widget_subtask_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="left|center_vertical"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:textColor="@color/acta_widget_text"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/acta_widget_subtask_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="32dp"
        android:background="@color/acta_widget_border"
        android:visibility="gone" />
</LinearLayout>
