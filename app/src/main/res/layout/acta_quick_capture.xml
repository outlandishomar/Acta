<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/acta_quick_capture_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/acta_dialog_surface"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/acta_quick_capture_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="New Task"
            android:textColor="@color/acta_widget_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/acta_quick_capture_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/acta_widget_muted_text"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/acta_quick_capture_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/acta_quick_capture_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/acta_dialog_field"
                android:gravity="top|start"
                android:hint="Task name"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textAutoCorrect"
                android:maxLength="500"
                android:maxLines="3"
                android:minLines="1"
                android:padding="12dp"
                android:textColor="@color/acta_widget_text"
                android:textColorHint="@color/acta_widget_muted_text"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/acta_quick_capture_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/acta_dialog_field"
                android:gravity="top|start"
                android:hint="Notes (optional)"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:maxLines="5"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/acta_widget_text"
                android:textColorHint="@color/acta_widget_muted_text"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/acta_quick_capture_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/acta_widget_accent" />

        <Button
            android:id="@+id/acta_quick_capture_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/acta_dialog_pill"
            android:minWidth="88dp"
            android:minHeight="44dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/acta_widget_on_accent" />
    </LinearLayout>
</LinearLayout>
