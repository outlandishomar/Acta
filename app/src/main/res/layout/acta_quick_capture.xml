<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/acta_quick_capture_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/acta_dialog_surface"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="22dp"
    android:paddingBottom="14dp">

    <ScrollView
        android:id="@+id/acta_quick_capture_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/acta_quick_capture_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:gravity="top|start"
                android:hint="What would you like to do?"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textAutoCorrect"
                android:maxLength="500"
                android:maxLines="3"
                android:minLines="1"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:textColor="@color/acta_widget_text"
                android:textColorHint="@color/acta_widget_muted_text"
                android:textSize="20sp" />

            <View
                android:id="@+id/acta_quick_capture_title_divider"
                android:layout_width="match_parent"
                android:layout_height="0.75dp"
                android:background="@color/acta_widget_border" />

            <EditText
                android:id="@+id/acta_quick_capture_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:hint="notes"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
                android:maxLines="5"
                android:minLines="1"
                android:paddingTop="4dp"
                android:paddingBottom="10dp"
                android:textColor="@color/acta_widget_muted_text"
                android:textColorHint="@color/acta_widget_muted_text"
                android:textSize="16sp" />

            <View
                android:id="@+id/acta_quick_capture_notes_divider"
                android:layout_width="match_parent"
                android:layout_height="0.75dp"
                android:background="@color/acta_widget_border" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/acta_quick_capture_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="40dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/acta_widget_muted_text"
            android:textSize="15sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/acta_quick_capture_save"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Done"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/acta_check_icon" />
    </LinearLayout>
</LinearLayout>
