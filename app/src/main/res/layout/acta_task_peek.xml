<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/acta_task_peek_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/acta_dialog_surface"
    android:elevation="8dp"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="14dp">

    <!-- Header Row: Checkbox + Title + Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/acta_task_peek_checkbox_target"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-4dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Complete task">

            <ImageView
                android:id="@+id/acta_task_peek_checkbox_box"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/acta_widget_checkbox_unchecked" />

            <ImageView
                android:id="@+id/acta_task_peek_checkbox_tick"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/acta_widget_checkmark"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="left|center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/acta_task_peek_task_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="7dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <TextView
                android:id="@+id/acta_task_peek_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="left|center_vertical"
                android:maxWidth="195dp"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:textColor="@color/acta_widget_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/acta_task_peek_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/acta_widget_muted_text"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/acta_task_peek_bell"
                android:layout_width="14.5dp"
                android:layout_height="14.5dp"
                android:layout_marginStart="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/acta_widget_bell_icon"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/acta_task_peek_repeat"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/repeaticon"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:orientation="vertical">

            <!-- Notes Section -->
            <TextView
                android:id="@+id/acta_task_peek_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:gravity="left|top"
                android:lineSpacingExtra="3dp"
                android:textAlignment="gravity"
                android:textColor="@color/acta_widget_muted_text"
                android:textSize="14.5sp"
                android:visibility="gone" />

            <!-- Subtasks Section -->
            <LinearLayout
                android:id="@+id/acta_task_peek_subtasks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layoutDirection="ltr"
                android:orientation="vertical"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Footer Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal">

        <Button
            android:id="@+id/acta_task_peek_open_app"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="12dp"
            android:text="Open in app"
            android:textAllCaps="false"
            android:textColor="@color/acta_widget_muted_text"
            android:textSize="13.5sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/acta_task_peek_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Done"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/acta_check_icon" />
    </LinearLayout>
</LinearLayout>
