<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/theappicon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/theappicon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Acta">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Acta">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
            </intent-filter>
        </activity>

        <!-- Default App Icon Alias -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/theappicon"
            android:roundIcon="@mipmap/theappicon_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 3 Dots App Icon Alias -->
        <activity-alias
            android:name=".MainActivity3Dots"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_3dots"
            android:roundIcon="@mipmap/icon_3dots_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Current 2 App Icon Alias -->
        <activity-alias
            android:name=".MainActivityCurrent2"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_current2"
            android:roundIcon="@mipmap/icon_current2_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Acta Word App Icon Alias -->
        <activity-alias
            android:name=".MainActivityActaWord"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/icon_actaword"
            android:roundIcon="@mipmap/icon_actaword_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Native AppWidget Receiver -->
        <receiver
            android:name=".widget.TaskWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/task_widget_info" />
        </receiver>

        <!-- Widget List RemoteViewsService -->
        <service
            android:name=".widget.TasksWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

        <!-- Widget Quick Capture Pop-up Activity -->
        <activity
            android:name=".widget.QuickCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.Acta.QuickCapture"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Widget Task Peek Pop-up Activity -->
        <activity
            android:name=".widget.TaskPeekActivity"
            android:exported="false"
            android:theme="@style/Theme.Acta.QuickCapture"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Widget Invisible Tap Handler Activity -->
        <activity
            android:name=".widget.WidgetTapActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Task Alarm Receiver -->
        <receiver
            android:name=".receiver.TaskAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>